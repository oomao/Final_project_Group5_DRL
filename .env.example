# Copy this file to `.env` and fill in the real values.
# `.env` is in .gitignore — it will NEVER be committed.

# Required when running `--reward-source llm`
# Get a key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Optional — defaults to "gemma-3-27b-it" if empty.
# Override here if Google AI Studio renames the model.
GEMMA_MODEL=
